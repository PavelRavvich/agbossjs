import { describe, expect, it } from "vitest";
import { ApiService } from "./api.service.js";

describe("ApiService", () => {
  it("builds URLs on the environment's API", () => {
    const api = new ApiService({ apiUrl: "https://api.example.com" });

    expect(api.url("/status")).toBe("https://api.example.com/status");
  });
});
